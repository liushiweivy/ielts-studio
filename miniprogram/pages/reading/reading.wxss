.passage-row { display: flex; align-items: center; gap: 22rpx; margin-bottom: 18rpx; }
.row-idx { font-size: 56rpx; color: #c0452f; opacity: .8; line-height: 1; }

.practice-bar { display: flex; gap: 14rpx; margin-bottom: 16rpx; }
.score-line { color: #c0452f; font-size: 36rpx; margin-bottom: 16rpx; }
.passage-title { font-size: 40rpx; }
.paragraph { font-size: 28rpx; text-align: justify; margin-bottom: 20rpx; line-height: 1.85; }

.q-item { padding: 24rpx 0; border-bottom: 1rpx dashed #ddd2bb; }
.q-item:last-child { border-bottom: none; }
.q-stem { font-weight: 700; font-size: 28rpx; margin-bottom: 14rpx; line-height: 1.7; }
.qn { color: #c0452f; margin-right: 6rpx; }
.opt {
  display: flex; gap: 14rpx; align-items: flex-start;
  padding: 16rpx 20rpx; border-radius: 12rpx; border: 2rpx solid transparent;
  margin-bottom: 8rpx; font-size: 27rpx;
}
.opt.picked { background: rgba(33,28,21,.06); }
.opt.correct { border-color: rgba(47,96,73,.5); background: rgba(47,96,73,.08); }
.opt.wrong { border-color: rgba(192,69,47,.5); background: rgba(192,69,47,.08); }
.opt-label { font-weight: 700; flex: none; }
.opt-text { flex: 1; }
.q-why {
  margin-top: 14rpx; padding: 16rpx 20rpx; border-radius: 12rpx;
  background: #efe7d5; font-size: 24rpx; color: #5b5144; line-height: 1.7;
}
.why-tag { color: #2f6049; font-weight: 800; margin-right: 8rpx; }
